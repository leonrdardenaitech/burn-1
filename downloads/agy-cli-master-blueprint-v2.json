      {
        "piece_id": "PUZZLE-08-BACKUP",
        "module_id": "MOD-008-BACKUP",
        "component_name": "Zero-Cost Immutable Cloud Backups & Storage Lock Setup Database",
        "source_file": "zero-cost-immutable-backups-guide.md",
        "role_in_system": "BCDR & Immutable Storage Setup Engine",
        "inputs": [

{
  "cli_metadata": {
    "tool_name": "agy",
    "full_name": "Agency CLI - SLM Orchestrator & Compliance Engine",
    "version": "2026.3.0",
    "source_authority": "Gemini Notebook Assessment Guides",
    "description": "Master configuration and component blueprint for agy CLI to ingest, map, chunk, embed, and orchestrate local SLM models and RAG workflows.",
    "created_at": "2026-10-11"
  },
  "environment_config": {
    "local_root_directory": "/drive/slm_library/",
    "vector_db": {
      "engine": "ChromaDB / Qdrant / FAISS Local",
      "collection_name": "agency_slm_knowledge_base",
      "distance_metric": "cosine",
      "embedding_model": "bge-large-en-v1.5",
      "chunking": {
        "strategy": "Semantic Markdown Header Splitting",
        "chunk_size": 512,
        "chunk_overlap": 64
      }
    },
    "slm_fine_tuning": {
      "target_format": "JSON-L (Instruction-Context-Response)",
      "output_directory": "/drive/slm_library/training_jsonl/",
      "train_eval_split": 0.9
    }
  },
  "puzzle_piece_architecture": {
    "description": "How the 8 core dataset components connect into a unified cybersecurity & compliance intelligence engine.",
    "components": [
      {
        "piece_id": "PUZZLE-01",
        "module_id": "MOD-001-PHISH",
        "component_name": "Phishing & Social Engineering Awareness Track",
        "source_file": "phishing-course-template-v2.md",
        "role_in_system": "Human Layer Defense & Awareness Input",
        "inputs": [
          "Real-world phishing vectors",
          "Role-based threat profiles"
        ],
        "outputs": [
          "User vulnerability metrics",
          "Reported threat logs",
          "Training completion state"
        ],
        "downstream_dependencies": [
          "PUZZLE-04 (SAQ Scorecard)",
          "PUZZLE-06 (Insurance Binder)"
        ]
      },
      {
        "piece_id": "PUZZLE-02",
        "module_id": "MOD-002-REM",
        "component_name": "Vulnerability Remediation, Virtual Patching & POA&M",
        "source_file": "remediation-poam-playbook-template.md",
        "role_in_system": "Technical Triage & Defect Resolution Engine",
        "inputs": [
          "Vulnerability scanner exports",
          "CVSS severity scores",
          "OT/IT asset tags"
        ],
        "outputs": [
          "Active POA&M tracker table",
          "Compensating control rules",
          "SLA compliance logs"
        ],
        "downstream_dependencies": [
          "PUZZLE-04 (SAQ Scorecard)",
          "PUZZLE-05 (SOP Compliance)",
          "PUZZLE-06 (Insurance Binder)"
        ]
      },
      {
        "piece_id": "PUZZLE-03",
        "module_id": "MOD-003-TTX",
        "component_name": "Tabletop Exercise (TTX) & Crisis Simulation Playbook",
        "source_file": "ttx-playbook-template.md",
        "role_in_system": "Operational Crisis & Incident Response Simulator",
        "inputs": [
          "Ransomware injects",
          "OT sabotage scenarios",
          "Supply chain breach narratives"
        ],
        "outputs": [
          "After-Action Reports (AAR)",
          "Executive IR readiness metrics",
          "Corrective action plans"
        ],
        "downstream_dependencies": [
          "PUZZLE-04 (SAQ Scorecard)",
          "PUZZLE-06 (Insurance Binder)"

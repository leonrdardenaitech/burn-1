  },
  "cli_commands_schema": {
    "agy init": {
      "description": "Initialize local drive taxonomy and verify file presence against slm-master-manifest-v2.yaml.",
      "exec": "agy init --config /drive/slm_library/slm-master-manifest-v2.yaml"
    },
    "agy ingest": {
      "description": "Parse, semantic-chunk, tag, and generate vector embeddings for ChromaDB/Qdrant.",
      "exec": "agy ingest --source /drive/slm_library/ --chunk-size 512 --overlap 64 --db-path /drive/slm_library/vector_db/"
    },
    "agy fine-tune": {
      "description": "Extract instruction-context-response JSON-L pairs for fine-tuning local SLM models.",
      "exec": "agy fine-tune --input-dir /drive/slm_library/ --out-file /drive/slm_library/training_jsonl/dataset.jsonl"
    },
    "agy audit": {
      "description": "Run automated self-assessment (SAQ) scoring against local vector DB and evidence files.",
      "exec": "agy audit --framework NIST_CSF_2.0 --output-report /drive/slm_library/audits/report.pdf"
    },
    "agy simulate": {
      "description": "Trigger automated tabletop exercise (TTX) scenario or phishing evaluation prompt for local users.",
      "exec": "agy simulate --module TTX --scenario ransomware_industrial_ot"
    },
    "agy export-binder": {
      "description": "Assemble and validate carrier-specific cyber insurance evidence package.",
      "exec": "agy export-binder --carrier Coalition --output /drive/slm_library/cyber_insurance_binder/"
    }
  }
}
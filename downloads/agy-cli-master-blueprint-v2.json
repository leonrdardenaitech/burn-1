        "component_name": "SLM Master Dataset Manifest v2",
        "source_file": "slm-master-manifest-v2.yaml",
        "role_in_system": "Data Indexing, Ingestion & Metadata Schema Directory",
        "inputs": [
          "All 7 module files and sector markdown documents"
        ],
        "outputs": [

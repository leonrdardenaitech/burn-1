{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.burn-1.com" }],
      "destination": "/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "burn-1.com" }],
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<subdomain>[^.]+)\\.burn-1\\.com" }],
      "destination": "/card.html"
    }
  ]
}

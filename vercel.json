      "destination": "/slawdawgs.html"
    },
    {
      "source": "/universal",
      "destination": "/universal_kiosk.html"
    },
    {
      "source": "/bowdega",
      "destination": "/bowdega.html"
    },
    {
      "source": "/barber",
